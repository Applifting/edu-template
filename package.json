{
  "private": true,
  "license": "MIT",
  "scripts": {
    "backend": "pnpm --filter backend",
    "frontend": "pnpm --filter frontend",
    "dev": "run-s \"backend docker:up:wait\" \"backend seed\" dev:servers",
    "dev:servers": "run-p \"backend start:dev\" \"frontend dev\"",
    "dev:down": "pnpm backend docker:down",
    "check-all": "run-s \"backend build\" \"frontend type-check\" \"frontend lint:check\" \"frontend format:check\"",
    "restart": "pnpm --filter backend restart && pnpm --filter frontend restart",
    "format": "run-s \"format:no-write --write --list-different\"",
    "format:check": "run-s \"format:no-write --check\"",
    "format:no-write": "prettier \"**/*.{cjs,js,ts,tsx,json,css,scss,graphql,md,yaml,yml}\" --ignore-path .prettierignore --ignore-path frontend/.prettierignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "dotenv-flow": "^4.1.0",
    "graphql": "^16.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "lodash": "4.17.21",
    "npm-run-all": "^4.1.5",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {},
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@compodoc/compodoc",
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "es5-ext",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
