{
  "private": true,
  "license": "MIT",
  "scripts": {
    "backend": "pnpm --filter backend",
    "frontend": "pnpm --filter frontend",
    "dev": "run-s \"backend docker:up:wait\" \"backend seed\" dev:servers",
    "dev:servers": "run-p \"backend start:dev\" \"frontend dev\"",
    "dev:down": "pnpm backend docker:down",
    "check-all": "run-s lint:fix format \"backend build\" \"frontend build:tsc\"",
    "restart": "pnpm --filter backend restart && pnpm --filter frontend restart",
    "format": "run-s \"format:no-write --write --list-different\"",
    "format:check": "run-s \"format:no-write --check\"",
    "format:no-write": "prettier \"**/*.{cjs,js,ts,tsx,json,css,scss,graphql,md,yaml,yml}\"",
    "lint": "eslint --ext .js,.ts,.tsx --report-unused-disable-directives --max-warnings=0 .",
    "lint:fix": "run-s \"lint --fix --cache\""
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "dotenv-flow": "^4.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "graphql": "^16.9.0",
    "lodash": "4.17.21",
    "npm-run-all": "^4.1.5",
    "prettier": "3.3.3",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {},
  "pnpm": {
    "overrides": {
      "better-auth": "1.2.7",
      "zod": "^3.22.5"
    },
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@compodoc/compodoc",
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "es5-ext",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
