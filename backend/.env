# Basic Auth Configuration
BETTER_AUTH_SECRET=development_secret_key_change_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=adminpassword

# Environment Configuration
NODE_ENV=development
ENV_NAME=local

# URLs
BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_RESET_PASSWORD_ROUTE=reset-password

# Database Configuration
DATABASE_URL=mysql://quackerUser:quackerPassword@db:3306/quacker
DATABASE_PROVIDER=mysql
POSTGRES_SSL=false

# Server Configuration
PORT=4000

# Logging Configuration
PRISMA_LOG=["query", "info", "warn", "error"]
LOG_HTTP_CLIENT_REQUESTS=true
PRETTY_PRINT_LOGS=true

# Cache Configuration
CACHE_TTL_MS=10000
CACHE_MAX_ITEMS=1000

# Mail Configuration (can be empty for development)
SMTP_HOST=
SMTP_SECURE=true
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD= 