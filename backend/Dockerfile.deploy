# Build context must be the repo root:
#   docker build -f backend/Dockerfile.deploy -t backend .

FROM node:22.15.0-alpine AS builder

RUN apk add --no-cache openssl
RUN corepack enable

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

RUN pnpm install --frozen-lockfile

COPY backend ./backend
COPY frontend ./frontend

ARG CI_COMMIT_SHA
ENV CI_COMMIT_SHA=$CI_COMMIT_SHA

RUN pnpm --filter backend build

# Produce a self-contained, hoisted runtime tree at /out with prod deps only.
# --legacy: backend has no injected workspace deps, so pnpm 10's default
# (which requires inject-workspace-packages=true) doesn't apply here.
RUN pnpm --filter backend deploy --legacy --prod /out


FROM node:22.15.0-alpine

RUN apk add --no-cache openssl

USER node
WORKDIR /home/node

COPY --from=builder --chown=node:node /out ./

ARG CI_COMMIT_SHA
ENV CI_COMMIT_SHA=$CI_COMMIT_SHA

CMD ["npm", "run", "start:migrate:prod"]
