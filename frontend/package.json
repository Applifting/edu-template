{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "format:check": "prettier --check './src/**/*.{ts,tsx,css,js,cjs,mjs,json}'",
    "format:fix": "prettier --write './src/**/*.{ts,tsx,css,js,cjs,mjs,json}'",
    "lint:check": "eslint './src/**/*.{ts,tsx,js,cjs,mjs}'",
    "lint:fix": "eslint --fix './src/**/*.{ts,tsx,js,cjs,mjs}'",
    "download-schema": "run-s \"download-schema:*\"",
    "download-schema:script": "node ./bin/download-schema.mjs",
    "download-schema:format": "prettier --write schema.graphql",
    "graphql": "run-s download-schema \"graphql:*\"",
    "graphql:codegen": "graphql-codegen",
    "graphql-watch": "graphql-codegen --watch",
    "restart": "touch ./tmp/restart.txt"
  },
  "dependencies": {
    "@apollo/client": "^3.11.8",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.100.0",
    "@tanstack/react-query-devtools": "^5.100.0",
    "@tanstack/react-router": "^1.168.0",
    "apollo-upload-client": "^18.0.1",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "cross-fetch": "^4.0.0",
    "date-fns": "^4.1.0",
    "graphql-tag": "^2.12.6",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.6.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "catalog:",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/client-preset": "^4.3.3",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-inspector/graphql-cli-common": "^2.9.0",
    "@parcel/watcher": "^2.4.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router-devtools": "^1.166.0",
    "@tanstack/router-plugin": "^1.161.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/apollo-upload-client": "^18.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "^5.0.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:lint",
    "jsdom": "^26.1.0",
    "node-fetch": "^3.3.2",
    "tailwindcss": "^4.2.4",
    "vite": "^7.1.0",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.0"
  }
}
